# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# PAYSTACK_SECRET_KEY: Your Paystack Secret Key (sk_test_... or sk_live_...)
# Used on the backend to initialize Paystack Hosted Checkout and verify transactions.
PAYSTACK_SECRET_KEY=""

# BREVO_API_KEY: Your Brevo v3 Transactional Email API Key (xkeysib-...)
# Used to email the Admin notification and Student course registration receipt.
BREVO_API_KEY=""

# BREVO_SENDER_EMAIL: Verified sender email address in your Brevo account.
BREVO_SENDER_EMAIL="oguntoyebidemisunkanmi@gmail.com"

# BREVO_SENDER_NAME: Sender display name for Brevo emails.
BREVO_SENDER_NAME="Othello Institute of Technology (OITpay)"

# ADMIN_NOTIFICATION_EMAIL: Admin email address that receives student registration alerts.
ADMIN_NOTIFICATION_EMAIL="oguntoyebidemisunkanmi@gmail.com"

# ADMIN_WHATSAPP_NUMBER: Official Othello WhatsApp number in international format (digits only, e.g. 2348012345678)
ADMIN_WHATSAPP_NUMBER="2348000000000"
